<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_P07" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Codex" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P07">
    <bpmn:participant id="Participant_P07_Company" name="Don vi cung cap dich vu" processRef="Process_P07" />
    <bpmn:participant id="Participant_P07_Client" name="Khach hang" processRef="Process_P07_Client" />
    <bpmn:messageFlow id="Message_P07_Ticket" sourceRef="Task_Client_CreateTicket" targetRef="Start_P07" name="Ticket ho tro" />
    <bpmn:messageFlow id="Message_P07_Response" sourceRef="Task_P07_Notify" targetRef="Catch_Client_Response" name="Thong bao da xu ly" />
    <bpmn:messageFlow id="Message_P07_Verify" sourceRef="Task_Client_Verify" targetRef="Start_P07_Verify" name="Ket qua kiem nghiem" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P07" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_P07">
      <bpmn:lane id="Lane_L1" name="L1 Support">
        <bpmn:flowNodeRef>Start_P07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_P07_Triage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_P07_FirstResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_P07_L1Resolve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_P07_L1Resolve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_P07_Escalate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_P07_Close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_P07</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_L2L3" name="L2 / L3 Support">
        <bpmn:flowNodeRef>Task_P07_Investigate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_P07_Fix</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_QA" name="QA / QC">
        <bpmn:flowNodeRef>Task_P07_Test</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DevOps" name="DevOps">
        <bpmn:flowNodeRef>Task_P07_Deploy</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SDM" name="Service Delivery Manager">
        <bpmn:flowNodeRef>Task_P07_Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_P07_Verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_P07_Verified</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:intermediateCatchEvent id="Start_P07" name="Ticket duoc tiep nhan">
      <bpmn:outgoing>Flow_P07_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_Start_P07" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_P07_Triage" name="Kiem tra thong tin va phan loai muc do uu tien">
      <bpmn:incoming>Flow_P07_1</bpmn:incoming>
      <bpmn:outgoing>Flow_P07_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_P07_FirstResponse" name="Phan hoi dau tien theo SLA">
      <bpmn:incoming>Flow_P07_2</bpmn:incoming>
      <bpmn:outgoing>Flow_P07_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_P07_L1Resolve" name="L1 tu xu ly duoc?">
      <bpmn:incoming>Flow_P07_3</bpmn:incoming>
      <bpmn:outgoing>Flow_P07_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_P07_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_P07_L1Resolve" name="Huong dan / xu ly loi co ban">
      <bpmn:incoming>Flow_P07_4</bpmn:incoming>
      <bpmn:outgoing>Flow_P07_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_P07_Escalate" name="Escalate ticket sang L2/L3">
      <bpmn:incoming>Flow_P07_5</bpmn:incoming>
      <bpmn:incoming>Flow_P07_15</bpmn:incoming>
      <bpmn:outgoing>Flow_P07_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_P07_Investigate" name="Phan tich log va tai hien loi">
      <bpmn:incoming>Flow_P07_6</bpmn:incoming>
      <bpmn:outgoing>Flow_P07_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_P07_Fix" name="Sua loi / tao patch hoac workaround">
      <bpmn:incoming>Flow_P07_7</bpmn:incoming>
      <bpmn:outgoing>Flow_P07_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_P07_Test" name="Regression test tren Staging / UAT">
      <bpmn:incoming>Flow_P07_8</bpmn:incoming>
      <bpmn:outgoing>Flow_P07_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_P07_Deploy" name="Deploy patch len Production">
      <bpmn:incoming>Flow_P07_9</bpmn:incoming>
      <bpmn:outgoing>Flow_P07_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_P07_Notify" name="Gui thong bao va yeu cau khach hang kiem nghiem">
      <bpmn:incoming>Flow_P07_10</bpmn:incoming>
      <bpmn:incoming>Flow_P07_11</bpmn:incoming>
      <bpmn:outgoing>Flow_P07_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Start_P07_Verify" name="Khach hang phan hoi">
      <bpmn:incoming>Flow_P07_12</bpmn:incoming>
      <bpmn:outgoing>Flow_P07_13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_Start_P07_Verify" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_P07_Verified" name="Khach hang xac nhan da dat?">
      <bpmn:incoming>Flow_P07_13</bpmn:incoming>
      <bpmn:outgoing>Flow_P07_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_P07_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_P07_Close" name="Dong ticket va cap nhat knowledge base">
      <bpmn:incoming>Flow_P07_14</bpmn:incoming>
      <bpmn:outgoing>Flow_P07_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_P07">
      <bpmn:incoming>Flow_P07_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_P07_1" sourceRef="Start_P07" targetRef="Task_P07_Triage" />
    <bpmn:sequenceFlow id="Flow_P07_2" sourceRef="Task_P07_Triage" targetRef="Task_P07_FirstResponse" />
    <bpmn:sequenceFlow id="Flow_P07_3" sourceRef="Task_P07_FirstResponse" targetRef="Gateway_P07_L1Resolve" />
    <bpmn:sequenceFlow id="Flow_P07_4" sourceRef="Gateway_P07_L1Resolve" targetRef="Task_P07_L1Resolve" name="Co" />
    <bpmn:sequenceFlow id="Flow_P07_5" sourceRef="Gateway_P07_L1Resolve" targetRef="Task_P07_Escalate" name="Khong" />
    <bpmn:sequenceFlow id="Flow_P07_6" sourceRef="Task_P07_Escalate" targetRef="Task_P07_Investigate" />
    <bpmn:sequenceFlow id="Flow_P07_7" sourceRef="Task_P07_Investigate" targetRef="Task_P07_Fix" />
    <bpmn:sequenceFlow id="Flow_P07_8" sourceRef="Task_P07_Fix" targetRef="Task_P07_Test" />
    <bpmn:sequenceFlow id="Flow_P07_9" sourceRef="Task_P07_Test" targetRef="Task_P07_Deploy" />
    <bpmn:sequenceFlow id="Flow_P07_10" sourceRef="Task_P07_Deploy" targetRef="Task_P07_Notify" />
    <bpmn:sequenceFlow id="Flow_P07_11" sourceRef="Task_P07_L1Resolve" targetRef="Task_P07_Notify" />
    <bpmn:sequenceFlow id="Flow_P07_12" sourceRef="Task_P07_Notify" targetRef="Start_P07_Verify" />
    <bpmn:sequenceFlow id="Flow_P07_13" sourceRef="Start_P07_Verify" targetRef="Gateway_P07_Verified" />
    <bpmn:sequenceFlow id="Flow_P07_14" sourceRef="Gateway_P07_Verified" targetRef="Task_P07_Close" name="Co" />
    <bpmn:sequenceFlow id="Flow_P07_15" sourceRef="Gateway_P07_Verified" targetRef="Task_P07_Escalate" name="Khong, can xu ly tiep" />
    <bpmn:sequenceFlow id="Flow_P07_16" sourceRef="Task_P07_Close" targetRef="End_P07" />
  </bpmn:process>
  <bpmn:process id="Process_P07_Client" isExecutable="false">
    <bpmn:startEvent id="Start_Client">
      <bpmn:outgoing>Flow_Client_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Client_CreateTicket" name="Tao ticket / gui yeu cau ho tro">
      <bpmn:incoming>Flow_Client_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Client_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Catch_Client_Response" name="Nhan phan hoi xu ly">
      <bpmn:incoming>Flow_Client_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Client_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_Catch_Client_Response" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_Client_Verify" name="Kiem nghiem va phan hoi ket qua">
      <bpmn:incoming>Flow_Client_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Client_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Client">
      <bpmn:incoming>Flow_Client_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Client_1" sourceRef="Start_Client" targetRef="Task_Client_CreateTicket" />
    <bpmn:sequenceFlow id="Flow_Client_2" sourceRef="Task_Client_CreateTicket" targetRef="Catch_Client_Response" />
    <bpmn:sequenceFlow id="Flow_Client_3" sourceRef="Catch_Client_Response" targetRef="Task_Client_Verify" />
    <bpmn:sequenceFlow id="Flow_Client_4" sourceRef="Task_Client_Verify" targetRef="End_Client" />
  </bpmn:process>
