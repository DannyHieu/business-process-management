<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_P10" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Codex" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P10">
    <bpmn:participant id="Participant_P10_Company" name="Cong ty phan mem" processRef="Process_P10" />
    <bpmn:participant id="Participant_P10_Vendor" name="Vendor" processRef="Process_P10_Vendor" />
    <bpmn:messageFlow id="Message_P10_PO" sourceRef="Task_P10_IssuePO" targetRef="Task_Vendor_ReceivePO" name="PO / hop dong mua sam" />
    <bpmn:messageFlow id="Message_P10_Delivery" sourceRef="Task_Vendor_Deliver" targetRef="Task_P10_InspectGoods" name="Thiet bi duoc giao" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P10" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_P10">
      <bpmn:lane id="Lane_Requester" name="Requester / PM">
        <bpmn:flowNodeRef>Start_P10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_P10_CreateRequest</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Manager" name="Line Manager">
        <bpmn:flowNodeRef>Task_P10_ApproveNeed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT" name="IT Asset Officer / IT Admin">
        <bpmn:flowNodeRef>Task_P10_CheckInventory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_P10_InStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_P10_PrepareAsset</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_P10_RegisterAsset</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_P10_Maintain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_P10_Dispose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_P10_Disposal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_P10</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance" name="Finance - Accounting">
        <bpmn:flowNodeRef>Task_P10_BudgetApproval</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Proc" name="Procurement">
        <bpmn:flowNodeRef>Task_P10_GetQuotes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_P10_IssuePO</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Warehouse" name="Warehouse / IT Support">
        <bpmn:flowNodeRef>Task_P10_InspectGoods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_P10_Handover</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_P10">
      <bpmn:outgoing>Flow_P10_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_P10_CreateRequest" name="Tao ticket yeu cau cap phat / mua sam">
      <bpmn:incoming>Flow_P10_1</bpmn:incoming>
      <bpmn:outgoing>Flow_P10_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_P10_ApproveNeed" name="Phe duyet nhu cau">
      <bpmn:incoming>Flow_P10_2</bpmn:incoming>
      <bpmn:outgoing>Flow_P10_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_P10_CheckInventory" name="Kiem tra ton kho va cau hinh chuan">
      <bpmn:incoming>Flow_P10_3</bpmn:incoming>
      <bpmn:outgoing>Flow_P10_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_P10_InStock" name="Con tai san phu hop?">
      <bpmn:incoming>Flow_P10_4</bpmn:incoming>
      <bpmn:outgoing>Flow_P10_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_P10_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_P10_PrepareAsset" name="Cai dat OS, phan mem va chinh sach bao mat">
      <bpmn:incoming>Flow_P10_5</bpmn:incoming>
      <bpmn:outgoing>Flow_P10_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_P10_BudgetApproval" name="Phe duyet ngan sach PR">
      <bpmn:incoming>Flow_P10_6</bpmn:incoming>
      <bpmn:outgoing>Flow_P10_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_P10_GetQuotes" name="Lay 3 bao gia va de xuat vendor">
      <bpmn:incoming>Flow_P10_7</bpmn:incoming>
      <bpmn:outgoing>Flow_P10_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_P10_IssuePO" name="Phat hanh PO / ky hop dong">
      <bpmn:incoming>Flow_P10_8</bpmn:incoming>
      <bpmn:outgoing>Flow_P10_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_P10_InspectGoods" name="Nhan hang, kiem dinh cau hinh">
      <bpmn:incoming>Flow_P10_9</bpmn:incoming>
      <bpmn:outgoing>Flow_P10_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_P10_RegisterAsset" name="Dan Asset Tag va cap nhat Snipe-IT/CMDB">
      <bpmn:incoming>Flow_P10_10</bpmn:incoming>
      <bpmn:outgoing>Flow_P10_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_P10_Handover" name="Ban giao tai san va ky bien ban">
      <bpmn:incoming>Flow_P10_11</bpmn:incoming>
      <bpmn:incoming>Flow_P10_12</bpmn:incoming>
      <bpmn:outgoing>Flow_P10_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_P10_Maintain" name="Theo doi su dung, bao tri va kiem ke dinh ky">
      <bpmn:incoming>Flow_P10_13</bpmn:incoming>
      <bpmn:outgoing>Flow_P10_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_P10_Dispose" name="Tai san het khau hao / hong nang?">
      <bpmn:incoming>Flow_P10_14</bpmn:incoming>
      <bpmn:outgoing>Flow_P10_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_P10_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_P10_Disposal" name="Thu hoi, xoa du lieu va thanh ly">
      <bpmn:incoming>Flow_P10_15</bpmn:incoming>
      <bpmn:outgoing>Flow_P10_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_P10">
      <bpmn:incoming>Flow_P10_16</bpmn:incoming>
      <bpmn:incoming>Flow_P10_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_P10_1" sourceRef="Start_P10" targetRef="Task_P10_CreateRequest" />
    <bpmn:sequenceFlow id="Flow_P10_2" sourceRef="Task_P10_CreateRequest" targetRef="Task_P10_ApproveNeed" />
    <bpmn:sequenceFlow id="Flow_P10_3" sourceRef="Task_P10_ApproveNeed" targetRef="Task_P10_CheckInventory" />
    <bpmn:sequenceFlow id="Flow_P10_4" sourceRef="Task_P10_CheckInventory" targetRef="Gateway_P10_InStock" />
    <bpmn:sequenceFlow id="Flow_P10_5" sourceRef="Gateway_P10_InStock" targetRef="Task_P10_PrepareAsset" name="Co" />
    <bpmn:sequenceFlow id="Flow_P10_6" sourceRef="Gateway_P10_InStock" targetRef="Task_P10_BudgetApproval" name="Khong" />
    <bpmn:sequenceFlow id="Flow_P10_7" sourceRef="Task_P10_BudgetApproval" targetRef="Task_P10_GetQuotes" />
    <bpmn:sequenceFlow id="Flow_P10_8" sourceRef="Task_P10_GetQuotes" targetRef="Task_P10_IssuePO" />
    <bpmn:sequenceFlow id="Flow_P10_9" sourceRef="Task_P10_IssuePO" targetRef="Task_P10_InspectGoods" />
    <bpmn:sequenceFlow id="Flow_P10_10" sourceRef="Task_P10_InspectGoods" targetRef="Task_P10_RegisterAsset" />
    <bpmn:sequenceFlow id="Flow_P10_11" sourceRef="Task_P10_PrepareAsset" targetRef="Task_P10_Handover" />
    <bpmn:sequenceFlow id="Flow_P10_12" sourceRef="Task_P10_RegisterAsset" targetRef="Task_P10_Handover" />
    <bpmn:sequenceFlow id="Flow_P10_13" sourceRef="Task_P10_Handover" targetRef="Task_P10_Maintain" />
    <bpmn:sequenceFlow id="Flow_P10_14" sourceRef="Task_P10_Maintain" targetRef="Gateway_P10_Dispose" />
    <bpmn:sequenceFlow id="Flow_P10_15" sourceRef="Gateway_P10_Dispose" targetRef="Task_P10_Disposal" name="Co" />
    <bpmn:sequenceFlow id="Flow_P10_16" sourceRef="Gateway_P10_Dispose" targetRef="End_P10" name="Khong" />
    <bpmn:sequenceFlow id="Flow_P10_17" sourceRef="Task_P10_Disposal" targetRef="End_P10" />
  </bpmn:process>
  <bpmn:process id="Process_P10_Vendor" isExecutable="false">
    <bpmn:startEvent id="Start_Vendor">
      <bpmn:outgoing>Flow_Vendor_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Vendor_ReceivePO" name="Nhan PO va xac nhan don hang">
      <bpmn:incoming>Flow_Vendor_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Vendor_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Vendor_Deliver" name="Giao thiet bi / tai lieu bao hanh">
      <bpmn:incoming>Flow_Vendor_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Vendor_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Vendor">
      <bpmn:incoming>Flow_Vendor_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Vendor_1" sourceRef="Start_Vendor" targetRef="Task_Vendor_ReceivePO" />
    <bpmn:sequenceFlow id="Flow_Vendor_2" sourceRef="Task_Vendor_ReceivePO" targetRef="Task_Vendor_Deliver" />
    <bpmn:sequenceFlow id="Flow_Vendor_3" sourceRef="Task_Vendor_Deliver" targetRef="End_Vendor" />
  </bpmn:process>
